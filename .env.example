# Required for OCR and Gemini translation
GOOGLE_API_KEY=

# Optional but recommended: when set, DeepSeek becomes the DEFAULT translation
# provider. deepseek-v4-flash benchmarked cheaper than every Gemini tier and
# was the most faithful Japanese -> Traditional Chinese translator tested.
# OCR always stays on Gemini.
DEEPSEEK_API_KEY=

# Economy / quality model overrides
# Do not move these back to gemini-2.5-*: on scanned CJK pages 2.5-flash-lite
# substitutes characters and simplifies Japanese kanji, and gemini-3.1-flash-lite
# is both cheaper and more accurate than gemini-2.5-flash.
GEMINI_OCR_MODEL=gemini-3.1-flash-lite
GEMINI_OCR_QUALITY_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSLATION_QUALITY_MODEL=gemini-3.7-flash
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash

# Optional prices for custom model IDs; otherwise the UI marks the estimate unavailable
# (USD per one million input/output tokens)
GEMINI_INPUT_PRICE_USD_PER_MILLION=
GEMINI_OUTPUT_PRICE_USD_PER_MILLION=
DEEPSEEK_INPUT_PRICE_USD_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_USD_PER_MILLION=

# Server limits
APP_HOST=127.0.0.1
APP_PORT=8765
MAX_UPLOAD_MB=50
MAX_WORKERS=2
JOB_TTL_HOURS=6
TRANSLATION_CHUNK_CHARS=12000
