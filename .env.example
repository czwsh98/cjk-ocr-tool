# Required for OCR and Gemini translation
GOOGLE_API_KEY=

# Optional: enables DeepSeek V4 Flash in the translation-provider menu
DEEPSEEK_API_KEY=

# Economy / quality model overrides
GEMINI_OCR_MODEL=gemini-2.5-flash-lite
GEMINI_OCR_QUALITY_MODEL=gemini-2.5-flash
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash-lite
GEMINI_TRANSLATION_QUALITY_MODEL=gemini-2.5-flash
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash

# Optional prices for custom model IDs; otherwise the UI marks the estimate unavailable
# (USD per one million input/output tokens)
GEMINI_INPUT_PRICE_USD_PER_MILLION=
GEMINI_OUTPUT_PRICE_USD_PER_MILLION=
DEEPSEEK_INPUT_PRICE_USD_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_USD_PER_MILLION=

# Server limits
APP_HOST=127.0.0.1
APP_PORT=8765
MAX_UPLOAD_MB=50
MAX_WORKERS=2
JOB_TTL_HOURS=6
TRANSLATION_CHUNK_CHARS=12000
